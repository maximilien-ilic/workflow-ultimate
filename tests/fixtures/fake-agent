#!/bin/sh

# Lancé à la place du vrai CLI, le scénario vient de FAKE_AGENT_SCENARIO.
case "${1:-}" in
  -c) scenario=${FAKE_AGENT_SCENARIO:-success}; agent=codex
      if [ "${3:-}" = resume ]; then printf 'Reprise du thread %s\n' "${4:-}"; fi ;;
  -*) scenario=${FAKE_AGENT_SCENARIO:-success}; agent=claude-code ;;
  *) scenario=${1:-success}; agent=${2:-claude-code} ;;
esac
case "$scenario" in
  success|error|question) ;;
  *) printf '%s\n' 'Scénario attendu : success, error ou question' >&2; exit 2 ;;
esac
case "$agent" in
  claude-code|codex) ;;
  *) printf '%s\n' 'Agent attendu : claude-code ou codex' >&2; exit 2 ;;
esac

root=$(CDPATH= cd "$(dirname "$0")/../.." && pwd) || exit 1
notify() {
  if [ "$agent" = codex ] && [ "$1" = turn-finished ]; then
    set -- "$1" '{"type":"agent-turn-complete","thread-id":"019a0000-0000-7000-8000-000000000001"}'
  fi
  "$root/resources/wu-notify" "$agent" "$@"
}

printf '%s\n' "$agent démarre" 'Travail en cours'
notify prompt-submitted
case "$scenario" in
  error)
    printf '%s\n' 'Erreur simulée' >&2
    notify error
    exit 1
    ;;
  question)
    printf '%s\n' 'Continuer ?'
    notify needs-input
    if ! IFS= read -r answer; then
      notify error
      exit 1
    fi
    printf '%s\n' 'Réponse reçue'
    notify prompt-submitted
    ;;
esac
printf '%s\n' 'Terminé'
notify turn-finished
