#!/bin/sh

# Lancé à la place de `claude` par l'appli (WU_CLAUDE_BIN), il reçoit les options de Claude
# (--session-id, --settings…) : le scénario vient alors de FAKE_AGENT_SCENARIO.
case "${1:-}" in
  -*) scenario=${FAKE_AGENT_SCENARIO:-success}; agent=claude-code ;;
  *) scenario=${1:-success}; agent=${2:-claude-code} ;;
esac
case "$scenario" in
  success|error|question) ;;
  *) printf '%s\n' 'Scénario attendu : success, error ou question' >&2; exit 2 ;;
esac
case "$agent" in
  claude-code|codex) ;;
  *) printf '%s\n' 'Agent attendu : claude-code ou codex' >&2; exit 2 ;;
esac

root=$(CDPATH= cd "$(dirname "$0")/../.." && pwd) || exit 1
notify() {
  "$root/resources/wu-notify" "$agent" "$1"
}

printf '%s\n' "$agent démarre" 'Travail en cours'
notify prompt-submitted
case "$scenario" in
  error)
    printf '%s\n' 'Erreur simulée' >&2
    notify error
    exit 1
    ;;
  question)
    printf '%s\n' 'Continuer ?'
    notify needs-input
    if ! IFS= read -r answer; then
      notify error
      exit 1
    fi
    printf '%s\n' 'Réponse reçue'
    notify prompt-submitted
    ;;
esac
printf '%s\n' 'Terminé'
notify turn-finished
